{
  "name": "render-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/cli/run-worker.js",
    "certify:ltx": "tsx src/cli/certify.ts --profile ltx-25-720p-97f",
    "certify:transition-soak": "tsx src/cli/certify-transition-soak.ts",
    "typecheck": "tsc --build",
    "certify": "tsx src/cli/certify.ts",
    "certify:flux": "tsx src/cli/certify.ts --profile flux-schnell-draft",
    "render": "tsx src/cli/render.ts",
    "worker": "tsx src/cli/run-worker.ts"
  },
  "dependencies": {
    "@cco/application": "workspace:*",
    "@cco/contracts": "workspace:*",
    "@cco/domain": "workspace:*",
    "@cco/infrastructure": "workspace:*",
    "@cco/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
