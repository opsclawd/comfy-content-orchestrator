# ==============================================================================
# Godzspeed Content Orchestrator - Control Plane Environment Schema (.env.example)
#
# NOTE: This file is the single exhaustive non-secret schema for the closed
# Docker Compose control plane topology. All credentials and IP addresses here
# are strictly synthetic examples. Real deployments must provide concrete,
# non-wildcard host IPs, valid distinct passwords, and authorized Tailscale IPs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Canonical Hostnames (Private Tailnet / MagicDNS)
# ------------------------------------------------------------------------------
REVIEW_HUB_HOSTNAME=review.godzspeed-internal.ts.net
CONTROL_API_HOSTNAME=control-01.godzspeed-internal.ts.net
STORAGE_HOSTNAME=storage-01.godzspeed-internal.ts.net

# ------------------------------------------------------------------------------
# 2. Network Bindings & Ports
# ------------------------------------------------------------------------------
# Reviewer-facing Tailscale mesh IP for Review Hub, Control API, and S3
TAILNET_IP=100.64.0.1

# Operator-only administrative binding IP for MinIO Console (never exposed to tailnet review clients)
OPERATOR_BIND_IP=127.0.0.1

# Published host ports
CONTROL_API_PORT=3000
REVIEW_HUB_PORT=3001
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. PostgreSQL Relational State (PostgreSQL 18.6)
# ------------------------------------------------------------------------------
POSTGRES_DB=godzspeed_orchestrator

# Migration owner role (superuser/schema owner used exclusively by one-shot migrate service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=synthetic_postgres_migration_password
DATABASE_MIGRATION_URL=postgresql://postgres:synthetic_postgres_migration_password@postgres:5432/godzspeed_orchestrator

# Application role (least-privilege role used by Control API runtime)
DATABASE_APP_ROLE=godzspeed_app
DATABASE_APP_USER=godzspeed_app
DATABASE_APP_PASSWORD=synthetic_godzspeed_app_password
DATABASE_URL=postgresql://godzspeed_app:synthetic_godzspeed_app_password@postgres:5432/godzspeed_orchestrator

# ------------------------------------------------------------------------------
# 4. MinIO S3 Object Storage (Review proxies & candidates)
# ------------------------------------------------------------------------------
# Bootstrap administrative credentials
MINIO_ROOT_USER=synthetic_minio_admin
MINIO_ROOT_PASSWORD=synthetic_minio_admin_password

# Application S3 access credentials
S3_ACCESS_KEY_ID=synthetic_s3_app_access_key
S3_SECRET_ACCESS_KEY=synthetic_s3_app_secret_access_key

# Internal storage endpoint (container-to-container inside private network)
S3_STORAGE_ENDPOINT=http://minio:9000

# Browser signing endpoint (presigned URLs resolved by reviewer browser over Tailscale)
S3_SIGNING_ENDPOINT=http://storage-01.godzspeed-internal.ts.net:9000

S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_READINESS_BUCKET=godzspeed-review
S3_PRESIGNED_EXPIRY_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Control API & Review Hub Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
CONTROL_API_HOST=0.0.0.0
# Internal API URL consumed by Review Hub inside the Compose network.
# Note: The render-worker host's separate, hand-maintained .env (on a different host,
# per docs/deployment-runbook.md:39-79) must continue to use the tailnet hostname/IP
# (e.g. http://control-01.godzspeed-internal.ts.net:3000) because it runs outside Docker.
CONTROL_API_URL=http://control-api:3000
# Fixed bridge IP of review-hub on the control-plane bridge network (must match compose.yaml).
# Not a Tailscale Serve address: review-hub acts as the trusted identity proxy terminating
# incoming connections and resolving client identity via tailscale whois.
CONTROL_API_TRUSTED_IDENTITY_PROXY_ADDRESSES=172.28.0.10
STORAGE_TELEMETRY_PATH=/var/lib/cco/storage-observation
JOB_LEASE_DURATION_MS=300000
JOB_HEARTBEAT_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 6. Render Worker Daemon Configuration
# ------------------------------------------------------------------------------
WORKER_ID=render-worker-01
WORKER_ALLOWED_JOB_KINDS=candidate
JOB_POLL_INTERVAL_MS=1000
JOB_TELEMETRY_BACKOFF_MS=5000
JOB_ADMISSION_BACKOFF_MS=5000

COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_RENDER_TIMEOUT_MS=300000
COMFYUI_DIR=/opt/ComfyUI

GPU_INDEX=0
GPU_LEASE_PATH=/tmp/comfy-content-orchestrator-gpu-0.lock

CERTIFICATION_MANIFEST_PATH=templates/provenance.json
GOLD_MASTER_PROVENANCE_PATH=templates/provenance.json

S3_CANDIDATE_BUCKET=godzspeed-review
S3_DELIVERY_BUCKET=godzspeed-delivery

# ------------------------------------------------------------------------------
# 7. Delivery Assembler Daemon Configuration
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ASSEMBLY_WORKSPACE_ROOT=/tmp/cco-assembly
LICENSE_REGISTRY_PATH=config/component-license-registry.json

# ------------------------------------------------------------------------------
# 8. Pinned Container Image Overrides
# ------------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:18.6
MINIO_IMAGE=minio/minio:RELEASE.2024-01-18T22-51-28Z
CONTROL_API_IMAGE=cco-control-api:latest
REVIEW_HUB_IMAGE=cco-web:latest
