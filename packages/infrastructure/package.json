{
  "name": "@cco/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "db:migrate": "tsx src/postgres/migrate.ts",
    "provenance": "tsx src/comfyui/provenance/cli.ts",
    "storage:provision": "tsx src/storage/provision.ts",
    "test:comfyui": "vitest run --config ../../vitest.comfyui.config.ts",
    "test:db": "vitest run --config ../../vitest.integration.config.ts",
    "test:kokoro": "bash ../../scripts/check-kokoro-version.sh && vitest run --config ../../vitest.kokoro.config.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.714.0",
    "@aws-sdk/s3-request-presigner": "^3.714.0",
    "@cco/application": "workspace:*",
    "@cco/contracts": "workspace:*",
    "@cco/domain": "workspace:*",
    "@cco/shared": "workspace:*",
    "kokoro-js": "^1.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.11.10",
    "dependency-cruiser": "^16.9.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
