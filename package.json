{
  "name": "comfy-content-orchestrator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "build": "tsc --build",
    "certify:ltx": "pnpm --filter render-worker certify:ltx",
    "certify:transition-soak": "pnpm --filter render-worker certify:transition-soak",
    "db:migrate": "pnpm --filter @cco/infrastructure db:migrate",
    "format": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bash": "node -e \"console.log('no bash test suite in this repo; TypeScript monorepo')\"",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --build --force",
    "certify": "pnpm --filter render-worker certify",
    "certify:flux": "pnpm --filter render-worker certify:flux"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "@eslint/js": "^9.17.0"
  }
}
