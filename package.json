{
  "name": "comfy-content-orchestrator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "build": "tsc --build",
    "certify:ltx": "pnpm --filter render-worker certify:ltx",
    "certify:transition-soak": "pnpm --filter render-worker certify:transition-soak",
    "db:migrate": "pnpm --filter @cco/infrastructure db:migrate",
    "format": "prettier --check .",
    "lint": "eslint .",
    "storage:provision": "pnpm --filter @cco/infrastructure storage:provision",
    "test": "vitest run",
    "bench:assembly": "pnpm build && node scripts/bench-assembly.mjs",
    "test:assembly": "vitest run --config vitest.assembly.config.ts",
    "test:bash": "node -e \"console.log('no bash test suite in this repo; TypeScript monorepo')\"",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:kokoro": "bash scripts/check-kokoro-version.sh && vitest run --config vitest.kokoro.config.ts",
    "test:sprint-1.5": "vitest run --config vitest.integration.config.ts apps/control-api/src/http/review-plane-closure.integration.test.ts packages/infrastructure/src/postgres/audit-protections.integration.test.ts",
    "typecheck": "tsc --build --force",
    "certify": "pnpm --filter render-worker certify",
    "certify:flux": "pnpm --filter render-worker certify:flux",
    "check:control-plane": "vitest run scripts/check-control-plane.test.js && node scripts/check-control-plane.js",
    "check:control-plane-images": "bash scripts/check-control-plane-images.sh",
    "check:hooks": "node scripts/check-hooks.js",
    "smoke:control-plane": "bash scripts/smoke-control-plane.sh",
    "postinstall": "node scripts/check-hooks.js || true"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write",
    "**/*.{js,jsx,mjs,cjs}": "prettier --write",
    "**/*.{json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
